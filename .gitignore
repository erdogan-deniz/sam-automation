# ── Общий блок репозиториев с сервером ──
# Только нейтральное: служебные файлы лежат в .git/info/exclude, не здесь.

# Аварийные дампы Git Bash / MSYS — появляются в корне сами, содержимого не несут.
*.stackdump

# Системный мусор Windows / macOS, временные файлы редакторов и Office.
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.tmp
*.bak
*~
~$*
nul
# ── конец общего блока ──

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.mypy_cache/
.venv/

# ── Secrets / Local Config ────────────────────────────────────────────────────
.env
config.yaml

# ── Runtime State ─────────────────────────────────────────────────────────────
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
err.log
**/.sam_version

# ── SAM Binaries (auto-downloaded on first run) ───────────────────────────────
external/SAM/*
!external/SAM/.gitkeep

# ── Debug dumps ───────────────────────────────────────────────────────────────
*.html

# ── Personal notes ────────────────────────────────────────────────────────────
TODO
TODO.md

# ── Tooling ───────────────────────────────────────────────────────────────────
*.orig

# IDE / local tooling
.vscode/

# ── Git worktrees ──────────────────────────────────────────────────────────────
.worktrees/
